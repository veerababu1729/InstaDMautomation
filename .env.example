# ─── Upstash Redis / Vercel KV (required in production on Vercel) ──────────
# Either Upstash direct:
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# OR Vercel KV (which provisions Upstash behind the scenes):
KV_REST_API_URL=https://your-kv-rest-api-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token

# ─── Optional: Explicitly set your deployment URL ────────────────────────────
# Vercel auto-sets NEXT_PUBLIC_VERCEL_URL in production.
# For local dev, the app uses window.location.origin automatically.
# NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app
